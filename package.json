{
    "name": "moms-milk",
    "version": "1.0.0",
    "description": "NestJS backend with Prisma and MySQL database",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prisma:generate": "prisma generate",
        "prisma:push": "prisma db push",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:migrate:reset": "prisma migrate reset",
        "prisma:studio": "prisma studio",
        "prisma:seed": "ts-node prisma/seed.ts",
        "docker:build": "docker compose build",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f",
        "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
        "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
        "docker:prod:build": "docker compose -f docker-compose.prod.yml up -d --build",
        "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
        "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
        "deploy:vps": "chmod +x deploy.sh && ./deploy.sh",
        "deploy:quick": "chmod +x quick-deploy.sh && ./quick-deploy.sh",
        "backup:create": "docker exec moms_milk_mysql_prod sh -c 'mysqldump -u root -p$MYSQL_ROOT_PASSWORD --all-databases' > backup_$(date +%Y%m%d_%H%M%S).sql",
        "health:check": "curl -f http://localhost:3001/health || echo 'API not responding'",
        "setup": "./scripts/setup.sh",
        "generate:sample-zipcodes": "ts-node src/scripts/generate-sample-zipcodes.ts",
        "import:zipcodes": "ts-node src/scripts/import-zipcodes.ts",
        "import:test": "npm run generate:sample-zipcodes && curl -X POST http://localhost:3003/geolocation/zipcodes/import"
    },
    "dependencies": {
        "@googlemaps/google-maps-services-js": "^3.4.2",
        "@nestjs/common": "^10.4.20",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.20",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.20",
        "@nestjs/platform-socket.io": "^10.4.20",
        "@nestjs/swagger": "^7.4.2",
        "@nestjs/websockets": "^10.4.20",
        "@nestjs-modules/mailer": "^2.0.2",
        "@prisma/client": "^5.22.0",
        "body-parser": "^1.20.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "firebase-admin": "^13.5.0",
        "minio": "^8.0.7",
        "nodemailer": "^6.10.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.1",
        "stripe": "^20.0.0",
        "swagger-ui-express": "^5.0.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.20",
        "@types/express": "^5.0.3",
        "@types/jest": "^29.5.14",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.15.29",
        "@types/nodemailer": "^6.4.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.3",
        "@types/xlsx": "^0.0.36",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "csv-parser": "^3.2.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.3",
        "jest": "^29.7.0",
        "prettier": "^3.5.3",
        "prisma": "^5.22.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.1",
        "ts-jest": "^29.3.4",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}