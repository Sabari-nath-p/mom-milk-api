// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  DONOR
  BUYER
  ADMIN
}

enum Gender {
  BOY
  GIRL
  OTHER
}

enum FeedType {
  BREAST
  BOTTLE
  OTHER
}

enum Position {
  LEFT
  RIGHT
  BOTH
}

enum DiaperType {
  SOLID
  LIQUID
  BOTH
  EMPTY
}

enum SleepLocation {
  CRIB
  BED
  STROLLER
  OTHER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum RequestType {
  MILK_REQUEST
  MILK_OFFER
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

// ─── E-Commerce Enums ─────────────────────────────────────────────────────────

enum EcomOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// ─── Marketplace Enums ────────────────────────────────────────────────────────

enum MarketplaceListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
}

enum MarketplaceCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum MarketplaceCategory {
  CRADLES
  TOYS
  CLOTHING
  STROLLERS
  CAR_SEATS
  FEEDING
  BATH
  SAFETY
  BOOKS
  EDUCATIONAL
  OTHER
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  phone    String
  zipcode  String
  userType UserType

  // Authentication fields
  isNew       Boolean   @default(true)
  isActive    Boolean   @default(true)
  fcmToken    String?
  lastLoginAt DateTime?

  // Donor specific fields (optional for other user types)
  description                    String?
  bloodGroup                     String?
  babyDeliveryDate               DateTime?
  healthStyle                    String? // JSON string array - optional
  ableToShareMedicalRecord       Boolean?  @default(false)
  isAvailable                    Boolean?  @default(true) // For donors - availability status
  lastAvailabilityNotificationAt DateTime? // Track last time availability notification was sent

  // Language preference
  language      String?   @default("English")

  // Social media links (optional for all users)
  facebookLink  String?
  instagramLink String?

  // Relationships
  babies           Baby[]
  otpVerifications OtpVerification[]

  // Request relationships
  sentRequests     MilkRequest[]         @relation("RequesterUser")
  receivedRequests MilkRequest[]         @relation("DonorUser")
  notifications    RequestNotification[]

  // E-Commerce & Vendor relationships
  vendorProfile         Vendor?
  ecomCart              EcomCart?
  ecomOrders            EcomOrder[]
  ecomReviews           EcomReview[]
  ecomReviewReplies     EcomReviewReply[]

  // Marketplace relationships
  marketplaceListings   MarketplaceListing[]
  savedListings         MarketplaceSavedListing[]

  // WebSocket tracking
  lastWsConnectedAt DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Donation  Donation[]

  @@map("users")
}

model Baby {
  id           Int      @id @default(autoincrement())
  name         String
  gender       Gender
  deliveryDate DateTime
  bloodGroup   String?
  weight       Float? // in kg
  height       Float? // in cm

  // Relationships
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Log relationships
  feedLogs   FeedLog[]
  diaperLogs DiaperLog[]
  sleepLogs  SleepLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("babies")
}

model FeedLog {
  id          Int       @id @default(autoincrement())
  feedingDate DateTime
  startTime   DateTime
  endTime     DateTime
  feedType    FeedType
  position    Position?
  amount      Float? // Made optional (was already optional)
  note        String?

  // Relationships
  babyId Int
  baby   Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feed_logs")
}

model DiaperLog {
  id         Int        @id @default(autoincrement())
  date       DateTime
  time       DateTime
  diaperType DiaperType
  note       String?

  // Relationships
  babyId Int
  baby   Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("diaper_logs")
}

model SleepLog {
  id           Int           @id @default(autoincrement())
  date         DateTime
  startTime    DateTime
  endTime      DateTime? // Made optional, will default to 3 hours later
  sleepQuality String? // Already optional
  location     SleepLocation
  note         String?

  // Relationships
  babyId Int
  baby   Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sleep_logs")
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)

  // Relationships
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otp_verifications")
}

model ZipCode {
  id        Int    @id @default(autoincrement())
  country   String
  zipcode   String @unique
  placeName String
  latitude  Float
  longitude Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, zipcode])
  @@index([latitude, longitude])
  @@map("zip_codes")
}

model MilkRequest {
  id          Int           @id @default(autoincrement())
  requestType RequestType   @default(MILK_REQUEST)
  status      RequestStatus @default(PENDING)

  // Request details
  title       String
  description String?
  quantity    Float? // in ml or other unit
  urgency     String? // LOW, MEDIUM, HIGH

  // Requester details
  requesterId Int
  requester   User @relation("RequesterUser", fields: [requesterId], references: [id], onDelete: Cascade)

  // Donor details (when accepted)
  donorId Int?
  donor   User? @relation("DonorUser", fields: [donorId], references: [id], onDelete: SetNull)

  // Location and distance
  requesterZipcode String
  donorZipcode     String?
  distance         Float? // in km

  // Timing
  neededBy    DateTime?
  acceptedAt  DateTime?
  completedAt DateTime?

  // Additional fields
  notes String?

  // Relations
  notifications RequestNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestType])
  @@index([requesterId])
  @@index([donorId])
  @@index([requesterZipcode])
  @@map("milk_requests")
}

model RequestNotification {
  id Int @id @default(autoincrement())

  // Notification details
  title   String
  message String
  type    String // AVAILABILITY_UPDATE, REQUEST_ACCEPTED, etc.

  // User details
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Related request
  requestId Int?
  request   MilkRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // Status
  isRead Boolean  @default(false)
  sentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@map("request_notifications")
}

model ChatSession {
  id Int @id @default(autoincrement())

  // Participants (parent and donor)
  parentId Int
  donorId  Int

  // Session metadata
  lastMessageAt DateTime @default(now())
  isActive      Boolean  @default(true)

  // Relations
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, donorId])
  @@index([parentId])
  @@index([donorId])
  @@index([lastMessageAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id Int @id @default(autoincrement())

  // Message details
  content String @db.Text

  // Sender details
  senderId Int

  // Session details
  sessionId Int
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Message status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Delivery status
  isDelivered Boolean   @default(false)
  deliveredAt DateTime?
  sentAt      DateTime? // When message was sent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Donation {
  id                    Int            @id @default(autoincrement())
  amount                Float
  currency              String
  stripePaymentIntentId String
  status                DonationStatus // <-- enum
  donorEmail            String?
  donorName             String?
  createdAt             DateTime       @default(now())
  user                  User?          @relation(fields: [userId], references: [id])
  userId                Int?

  @@map("donations")
}

// ═════════════════════════════════════════════════════════════════════════════
// E-COMMERCE MODELS
// ═════════════════════════════════════════════════════════════════════════════

/// Vendor / Seller profile — any User (BUYER or DONOR) can become a vendor
model Vendor {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName   String
  description String?  @db.Text
  logoUrl     String?
  zipcode     String
  address     String?

  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)

  products    EcomProduct[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zipcode])
  @@map("vendors")
}

/// Product category (admin-managed, flat list for simplicity)
model EcomCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  products    EcomProduct[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ecom_categories")
}

/// Base product — supports variant-less (hasVariants=false) and multi-variant products
model EcomProduct {
  id            Int          @id @default(autoincrement())
  vendorId      Int
  vendor        Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryId    Int?
  category      EcomCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name          String
  description   String?      @db.Text
  basePrice     Float
  stock         Int          @default(0)   // used when hasVariants = false
  hasVariants   Boolean      @default(false)
  isActive      Boolean      @default(true)
  zipcode       String       // seller location for geo-based filtering
  tags          String?      // JSON array of strings e.g. '["baby","organic"]'

  averageRating Float?       @default(0)
  totalReviews  Int          @default(0)

  variants      EcomProductVariant[]
  images        EcomProductImage[]
  reviews       EcomReview[]
  orderItems    EcomOrderItem[]
  cartItems     EcomCartItem[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@index([zipcode])
  @@index([isActive])
  @@map("ecom_products")
}

/// A variant of a product (e.g., "Red - Large", "Blue - Medium")
model EcomProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  product    EcomProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  name       String      // e.g. "Red - Large"
  sku        String?
  price      Float       // override base price
  stock      Int         @default(0)
  attributes String?     // JSON: {"color":"Red","size":"L"}
  isActive   Boolean     @default(true)

  cartItems  EcomCartItem[]
  orderItems EcomOrderItem[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
  @@map("ecom_product_variants")
}

/// Product images
model EcomProductImage {
  id        Int         @id @default(autoincrement())
  productId Int
  product   EcomProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  isPrimary Boolean     @default(false)
  sortOrder Int         @default(0)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId])
  @@map("ecom_product_images")
}

/// Shopping cart — one per user
model EcomCart {
  id        Int           @id @default(autoincrement())
  userId    Int           @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     EcomCartItem[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("ecom_carts")
}

/// Items inside a cart
model EcomCartItem {
  id        Int                 @id @default(autoincrement())
  cartId    Int
  cart      EcomCart            @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId Int
  product   EcomProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId Int?
  variant   EcomProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity  Int                 @default(1)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("ecom_cart_items")
}

/// An order placed by a user
model EcomOrder {
  id            Int             @id @default(autoincrement())
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        EcomOrderStatus @default(PENDING)
  totalAmount   Float
  notes         String?

  // Shipping address snapshot at time of order
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingZipcode String?

  items         EcomOrderItem[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@map("ecom_orders")
}

/// Line items in an order
model EcomOrderItem {
  id        Int                 @id @default(autoincrement())
  orderId   Int
  order     EcomOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   EcomProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId Int?
  variant   EcomProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot at purchase time
  productName   String
  variantName   String?
  unitPrice     Float
  quantity      Int

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("ecom_order_items")
}

/// Product review by any user — verified purchase flag shows which ones are from buyers
model EcomReview {
  id                 Int               @id @default(autoincrement())
  productId          Int
  product            EcomProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId             Int
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId            Int?              // if linked to order → isVerifiedPurchase = true

  rating             Int               // 1–5
  title              String?
  body               String?           @db.Text
  images             String?           // JSON array of image URLs

  isVerifiedPurchase Boolean           @default(false)
  isHidden           Boolean           @default(false) // admin can hide

  replies            EcomReviewReply[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([productId, userId])        // one review per user per product
  @@index([productId])
  @@index([userId])
  @@map("ecom_reviews")
}

/// A reply to a review (by seller, buyer, or admin)
model EcomReviewReply {
  id        Int        @id @default(autoincrement())
  reviewId  Int
  review    EcomReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  body      String     @db.Text

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([reviewId])
  @@map("ecom_review_replies")
}

// ═════════════════════════════════════════════════════════════════════════════
// MARKETPLACE MODELS
// ═════════════════════════════════════════════════════════════════════════════

/// A P2P listing for kids/baby items (Facebook Marketplace style)
model MarketplaceListing {
  id          Int                      @id @default(autoincrement())
  userId      Int
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?                  @db.Text
  price       Float
  category    MarketplaceCategory
  condition   MarketplaceCondition
  zipcode     String                   // seller location for geo filtering
  placeName   String?                  // human-readable location

  // Optional product detail fields
  originPrice Float?                   // original/retail price
  purchasedOn DateTime?                // date item was originally purchased
  brand       String?                  // brand name
  materials   String?                  // JSON array of strings e.g. '["Wood","Cotton"]'
  colors      String?                  // JSON array of strings e.g. '["Red","Blue"]'
  dimensions  String?                  // e.g. "30cm x 20cm x 15cm"
  boxContains String?                  // JSON array of strings e.g. '["Cradle","Mattress"]'

  status      MarketplaceListingStatus @default(ACTIVE)

  images      MarketplaceImage[]
  savedBy     MarketplaceSavedListing[]

  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([userId])
  @@index([zipcode])
  @@index([category])
  @@index([status])
  @@map("marketplace_listings")
}

/// Images for a marketplace listing
model MarketplaceImage {
  id        Int                @id @default(autoincrement())
  listingId Int
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url       String
  isPrimary Boolean            @default(false)
  sortOrder Int                @default(0)

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([listingId])
  @@map("marketplace_images")
}

/// A user's saved/bookmarked marketplace listings
model MarketplaceSavedListing {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId Int
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime           @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@map("marketplace_saved_listings")
}

